# RentGuard AI - Environment Configuration
# Copy this file to .env and provide your Groq API key (starts with gsk_...)

# Primary LLM Provider: Groq (Ultra-fast, Llama-3.3-70B / Llama-3.1-8B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
